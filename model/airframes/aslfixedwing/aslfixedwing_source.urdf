<?xml version="1.0"?>
<robot name="aslfixedwing">
  <link name="base_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.5"/><inertia ixx="0.197563" ixy="0" ixz="0" iyy="0.145893" iyz="0" izz="0.1477"/></inertial>
    <collision name="base_link_collision"><origin xyz="0 0 -0.1" rpy="0 0 0"/><geometry><box size="0.47 0.47 0.11"/></geometry></collision>
    <visual name="base_link_visual"><origin xyz="-0.2 0 0" rpy="0 0 3.1415"/><geometry><mesh filename="meshes/aslfixedwing.obj" scale="1 1 1"/></geometry></visual>
  </link>
  <link name="aslfixedwing/imu_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.015"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
  </link>
  <joint name="aslfixedwing/imu_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="aslfixedwing/imu_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0" effort="1000" velocity="100"/>
  </joint>
  <link name="rotor_puller">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.005"/><inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="0.000166704" iyz="0" izz="0.000167604"/></inertial>
    <collision name="rotor_puller_collision"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.1" length="0.005"/></geometry></collision>
    <visual name="rotor_puller_visual"><origin xyz="-0.06 0 -0.39" rpy="0 0 0"/><geometry><mesh filename="meshes/propeller_cw.obj" scale="0.75 0.75 0.75"/></geometry></visual>
  </link>
  <joint name="rotor_puller_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_puller"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1e+16" upper="1e+16" effort="1000" velocity="100"/>
  </joint>
  <link name="left_elevon">
    <inertial><origin xyz="0 0.3 0" rpy="0 0 0"/><mass value="1e-08"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <link name="right_elevon">
    <inertial><origin xyz="0 -0.3 0" rpy="0 0 0"/><mass value="1e-08"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <link name="elevator">
    <inertial><origin xyz="-0.5 0 0" rpy="0 0 0"/><mass value="1e-08"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <link name="rudder">
    <inertial><origin xyz="-0.5 0 0.05" rpy="0 0 0"/><mass value="1e-08"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <joint name="left_elevon_joint" type="revolute">
    <origin xyz="0 0.3 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_elevon"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.53" upper="0.53" effort="1000" velocity="100"/>
  </joint>
  <joint name="right_elevon_joint" type="revolute">
    <origin xyz="0 -0.3 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_elevon"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.53" upper="0.53" effort="1000" velocity="100"/>
  </joint>
  <joint name="elevator_joint" type="revolute">
    <origin xyz="-0.5 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="elevator"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.53" upper="0.53" effort="1000" velocity="100"/>
  </joint>
  <joint name="rudder_joint" type="revolute">
    <origin xyz="-0.5 0 0.05" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rudder"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.53" upper="0.53" effort="1000" velocity="100"/>
  </joint>
</robot>
