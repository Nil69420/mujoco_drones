<mujoco model="synth">
  <compiler angle="radian"/>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <freejoint name="root"/>
    <site name="imu_site" pos="0 0 0"/>
    <site name="lidar_site" pos="0 0 -0.02"/>
    <site name="infrared_site" pos="0 0 -0.06" quat="0 1 0 0"/>
    <body name="rotor_link" pos="0 0 0.5">
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
      <joint name="rotor_1_joint" pos="0 0 0" axis="0 0 1"/>
      <site name="rotor_1_joint_thrust_site" pos="0 0 0"/>
    </body>
    <body name="elevon_link" pos="0 1 0">
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
      <joint name="elevon_left" pos="0 0 0" axis="0 0 1" range="-0.5 0.5" actuatorfrcrange="-1 1"/>
    </body>
    </body>
  </worldbody>

  <actuator>
    <general name="rotor_1_joint" site="rotor_1_joint_thrust_site" gear="0 0 1 0 0 0"/>
    <general name="elevon_left" joint="elevon_left" biastype="affine" gainprm="40" biasprm="2.5 0.1"/>
  </actuator>

  <sensor>
    <accelerometer site="imu_site" name="imu_accel"/>
    <gyro site="imu_site" name="imu_gyro"/>
    <framequat objtype="site" objname="imu_site" name="orientation"/>
    <framepos objtype="site" objname="imu_site" name="position"/>
    <framexaxis objtype="site" objname="imu_site" name="heading"/>
    <velocimeter site="imu_site" name="linvel"/>
    <frameyaxis objtype="site" objname="imu_site" name="mag_y"/>
    <framezaxis objtype="site" objname="imu_site" name="mag_z"/>
  </sensor>
</mujoco>
