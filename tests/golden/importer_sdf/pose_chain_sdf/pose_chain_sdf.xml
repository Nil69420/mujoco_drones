<mujoco model="pose_chain_sdf">
  <compiler angle="radian"/>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.02"/>
      <freejoint name="root"/>
    <geom name="base_collision" size="0.1 0.1 0.025" type="box"/>
    <site name="imu_site" pos="0 0 0"/>
    <site name="lidar_site" pos="0 0 -0.02"/>
    <site name="infrared_site" pos="0 0 -0.06" quat="0 1 0 0"/>
    <body name="arm_link" pos="0.2 0.05 0" quat="0.707107 0 0 0.707107">
      <inertial pos="0.05 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      <joint name="arm_joint" pos="0 0 0" axis="0 0 1" range="-1 1" actuatorfrcrange="-1000 1000"/>
      <body name="elbow_link" pos="0.3 0 0" quat="0.707107 0 0 -0.707107">
        <inertial pos="0 0 0" mass="0.05" diaginertia="1e-05 1e-05 1e-05"/>
        <joint name="elbow_joint" pos="0 0 0" axis="0 0 1" range="-1 1" actuatorfrcrange="-1000 1000"/>
        <body name="wheel_link" pos="0 0 0.3" quat="0.707107 0.707107 0 0">
          <inertial pos="0 0 0" mass="0.02" diaginertia="1e-06 1e-06 1e-06"/>
          <joint name="wheel_joint" pos="0 0 0" axis="0 1 0" range="-1 1" actuatorfrcrange="-1000 1000"/>
        </body>
      </body>
    </body>
    </body>
  </worldbody>

  <actuator>
    <general name="arm_joint" joint="arm_joint" biastype="affine" gainprm="40" biasprm="0.25 0.01"/>
    <general name="elbow_joint" joint="elbow_joint" biastype="affine" gainprm="40" biasprm="0.025 0.001"/>
    <general name="wheel_joint" joint="wheel_joint" biastype="affine" gainprm="40" biasprm="0.0025 0.0001"/>
  </actuator>

  <sensor>
    <accelerometer site="imu_site" name="imu_accel"/>
    <gyro site="imu_site" name="imu_gyro"/>
    <framequat objtype="site" objname="imu_site" name="orientation"/>
    <framepos objtype="site" objname="imu_site" name="position"/>
    <framexaxis objtype="site" objname="imu_site" name="heading"/>
    <velocimeter site="imu_site" name="linvel"/>
    <frameyaxis objtype="site" objname="imu_site" name="mag_y"/>
    <framezaxis objtype="site" objname="imu_site" name="mag_z"/>
  </sensor>
</mujoco>
