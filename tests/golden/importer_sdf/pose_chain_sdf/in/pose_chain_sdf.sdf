<?xml version="1.0"?>
<sdf version="1.6">
  <model name="pose_chain_sdf">
    <link name="base_link">
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.2 0.2 0.05</size></box></geometry>
      </collision>
    </link>
    <link name="arm_link">
      <pose>0.2 0 0.5 0 0 1.5707963267948966</pose>
      <inertial>
        <pose>0.1 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="arm_visual">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry><box><size>0.2 0.02 0.02</size></box></geometry>
      </visual>
    </link>
    <link name="elbow_link">
      <pose>0.2 0.3 0.5 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
    </link>
    <link name="wheel_link">
      <pose>0.2 0.3 0.8 1.5707963267948966 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>
    <joint name="arm_joint" type="revolute">
      <pose>0.05 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>arm_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1</lower><upper>1</upper></limit></axis>
    </joint>
    <joint name="elbow_joint" type="revolute">
      <parent>arm_link</parent>
      <child>elbow_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1</lower><upper>1</upper></limit></axis>
    </joint>
    <joint name="wheel_joint" type="revolute">
      <parent>elbow_link</parent>
      <child>wheel_link</child>
      <axis><xyz>0 0 1</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1</lower><upper>1</upper></limit></axis>
    </joint>
  </model>
</sdf>
