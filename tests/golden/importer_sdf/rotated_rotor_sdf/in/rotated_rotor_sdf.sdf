<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rotated_rotor_sdf">
    <link name="base_link">
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.05</iyy><iyz>0</iyz><izz>0.08</izz></inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.6 0.2 0.05</size></box></geometry>
      </collision>
    </link>
    <link name="rotor_puller">
      <pose>0.3 0 0 0 1.5707963267948966 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.005</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_puller_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_puller</child>
      <axis><xyz>1 0 0</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
  </model>
</sdf>
